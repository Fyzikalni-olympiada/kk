@{block #page}
<h1>{!$heading}</h1>
<div id="editable">
    {!$html}
</div>
{if $publish==1}<!-- datadáze-->
  {foreach $section as $item}
    {if $iterator->first && $iterator->last}{else}
        <h2>{$item->name}</h2>
    {/if}
    <table width="100%" style="font-size:125%">
      <thead>
        <tr>{!$item->titleline}</tr>
      </thead>
      <tbody>
        {!$item->table}
      </tbody>
    </table>
  {/foreach}
{elseif $publish==2}<!--html-->
{elseif $publish==3}<!--excel-->
  {ifset $emptyXls}
    <p>Výsledková listina nebyla nahrána do repozitáře.</p>
  {else}
    {!$data->render()}
  {/if}
{/if}

<div id="editable">
    {!$document->html}
</div>

