@{block #content}
<h1>{!$heading}</h1>
<div id="editable">
    {!$document->html}
</div>
{foreach $section as $item}
    {if $iterator->first && $iterator->last}{else}
        <h2>{$item->name}</h2>
    {/if}
    <table style="font-size:110%;">
    <tr>{!$item->titleline}</tr>
    {!$item->table}
    </table>

{/foreach}

