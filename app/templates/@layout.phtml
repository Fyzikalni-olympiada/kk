<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:fb="http://www.facebook.com/2008/fbml" xmlns:g="http://base.google.com/ns/1.0" xmlns:og="http://opengraphprotocol.org/schema/" lang="cs" xml:lang="cs">
<head>
{control metas}
{block #metas}
{/block}
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

{control css 'screen.css', 'jquery-ui.css'}
<link rel="stylesheet" media="screen,projection,tv,print" href="{$baseUri}css/screen-safari.css" type="text/css" n:if="$browser->isSafari(534)"/>
<link rel="stylesheet" media="screen,projection,tv,print" href="{$baseUri}css/screen-opera10.css" type="text/css" n:if="$browser->isOpera(10)"/>
<link rel="stylesheet" media="screen,projection,tv,print" href="{$baseUri}css/screen-ie9.css" type="text/css" n:if="$browser->isIe(9)"/>
<link rel="stylesheet" media="screen,projection,tv,print" href="{$baseUri}css/screen-ie8.css" type="text/css" n:if="$browser->isIe(8)"/>
<link rel="stylesheet" media="screen,projection,tv,print" href="{$baseUri}css/screen-ie7.css" type="text/css" n:if="$browser->isIe(7)"/>
<link rel="stylesheet" media="screen,projection,tv,print" href="{$baseUri}css/screen-ie6.css" type="text/css" n:if="$browser->isIe(6)"/>
<link rel="stylesheet" media="print" href="{$baseUri}css/print.css" type="text/css" />

{control js 'jquery.js', 'jquery.nette.js', 'jquery.ajaxform.js', 'jquery-ui.js', 'jquery.prettyPhoto.js', 'analytics.js', 'front-scripts.js'}
{*control aloha*}
{block #scripts}{/block}

<style type="text/css" n:syntax="double">
{{if $subdomain=='//praha'}}
a,dt,table th,#logo h2,#logo h1 a,#right-col .menu li.current a,#menu-top li a:hover,#menu-top li.current a,#menu-top li.ancestor a {color: #801515}
.inputbox:focus {background:#FFAAAA}
table th {background: #FFAAAA; border-color: #D46A6A #AA3939 #D46A6A #AA3939}
#top-container:before,.topArea {border-top-color: #AA3939; background: #FFAAAA}
.bannerfooter_text a {color:#D46A6A}
div.moduletable h3,span.highlight {color:#AA3939; border-bottom-color: #AA3939} 

{{elseif $subdomain=='//plzen'}}
a,dt,table th,#logo h2,#logo h1 a,#right-col .menu li.current a,#menu-top li a:hover,#menu-top li.current a,#menu-top li.ancestor a {color: #0655A6}
.inputbox:focus {background:#B2CFEC}
table th {background: #B2CFEC; border-color: #4289D2 #1771CF #4289D2 #1771CF}
#top-container:before,.topArea {border-top-color: #1771CF; background: #B2CFEC}
.bannerfooter_text a {color:#4289D2}
div.moduletable h3,span.highlight {color:#1771CF; border-bottom-color: #1771CF} 

{{elseif $subdomain=='//kvary'}}
#logo a {font-size: 66px}
a,dt,table th,#logo h2,#logo h1 a,#right-col .menu li.current a,#menu-top li a:hover,#menu-top li.current a,#menu-top li.ancestor a {color: #9F5205}
.inputbox:focus {background:#F8D0A8}
table th {background: #F8D0A8; border-color: #D5995D #BA7129 #D5995D #BA7129}
#top-container:before,.topArea {border-top-color: #BA7129; background: #F8D0A8}
.bannerfooter_text a {color:#D5995D}
div.moduletable h3,span.highlight {color:#BA7129; border-bottom-color: #BA7129} 
{{/if}}
</style>

</head>
<body id="com_content" class="background c3 viewfrontpage itemid1">
<div id="top-container">
  <div id="top">
    <div class="topArea">
        <div id="menu-top">
            {control navigation}
        </div>
        <!--div id="search">
            <form action="index.php" method="post">
                <div class="search">
                    <input name="searchword" id="mod_search_searchword" maxlength="20" alt="Search" class="inputbox" type="text" size="20" placeholder="hledat..." />    
                </div>
            </form>
        </div-->
        <div class="clr"></div>
    </div>    
    <div id="logo"><h1><a href="{dlink $subdomain}" title="Fyzikální olympiáda {$site->name}">Fyzikální olympiáda {$site->name}</a></h1>
      <h2>{$site->subtitle}</h2>
    </div>
    <div class="clr"></div>
  </div>
  <div id="content">
    @{include #page}
  </div>
</div>
<div id="footer">
  <div id="credits">Copyright &copy; 2012</div>
  <div id="design">Designed by <a target="_blank" href="http://www.styleshout.com/">Styleshout</a></div>
  <div class="clr"></div>
</div>

    <div id="fb-root"></div>
    {snippet flashes}
        {var $firstFlash => reset($flashes)}
        <div n:if="$firstFlash" id="flashes" class="text" title="{if $firstFlash->type=='warning'}{_'Upozornění'}{elseif $firstFlash->type=='error'}{_'Chyba'}{else}{_'Zpráva'}{/if}">
            {foreach $flashes as $flash}<p class="flash {$flash->type}">{!$flash->message}</p>{/foreach}
        </div>
        <script type="text/javascript" n:if="count($flashes)>0">
            $(function(){
                $.nette.openFlash();
            });
        </script>
    {/snippet}

    {dialog dialog, #page}
</body>
</html>
