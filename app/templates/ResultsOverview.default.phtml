@{block #content}
<h1>{$heading}</h1>
<div id="editable">
    {!$document->html}
</div>

{foreach $list as $item}
{if $link==true}
<h2>{$item->name}</h2>
{else}
<h2><a href="{dlink $item->path}" title="{$item->title}">{$item->name}</a></h2>
{/if}
<ul>
{foreach $presenter->repository->getChildren($item->path,null,array("position","ASC")) as $subitem}
    {if $link==true}
        <li><a href="{dlink $subitem->path}" title="{$subitem->title}">{$subitem->name}</a></li>
    {else}
        <li><i>{$subitem->name}</i></li>
    {/if}
    {foreach $presenter->repository->getChildren($subitem->path,null,array("position","ASC")) as $subitem}
        <a href="{dlink $subitem->path}" title="{$subitem->title}">{$subitem->name}</a>
        <span style="width: 15px;">&nbsp;</span>
    {/foreach}
{/foreach}
</ul>
{/foreach}
{control overview}
