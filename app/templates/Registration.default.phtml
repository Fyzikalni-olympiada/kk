@{block #page}

<script type="text/javascript">
  function noBack()
  {
    window.history.forward()
  }
  noBack();
  window.onload = noBack;
  window.onpageshow = function(evt) { if (evt.persisted) noBack() }
  window.onunload = function() { void(0) }
</script>

<h1>{$heading}</h1>
<div id="editable">
    {!$document->html}
</div>

<style>
p.error{
    margin: 10px;
}
</style>
<div style="background-color:#ffaaaa"><p class="error">{!$errorMsg}</p></div>
<div style="background-color:#ffffaa"><p class="error">{!$warnMsg}</p></div>
<div style="background-color:#aaffaa"><p class="error">{!$okMsg}</p></div>


<form name="header" method="POST" action="./">
  <input type="hidden" name="status"      value="{$status}">
  <input type="hidden" name="refName"     value="{$refName}">
  <input type="hidden" name="refMail"     value="{$refMail}">
  <input type="hidden" name="refPhone"    value="{$refPhone}">
  <input type="hidden" name="refSchool"   value="{$refSchool}">
  <input type="hidden" name="schName"     value="{$schName}">
  <input type="hidden" name="schFullName" value="{$schFullName}">
  <input type="hidden" name="schAdr"      value="{$schAdr}">
  <input type="hidden" name="schEmail"    value="{$schEmail}">


  <p>
    status={$status}<br />
    Uživatel: {$user}<br />
    <input type="submit" name="logoutBT" value="Odhlásit se" class="button" ><br />
  </p>


{*login*}
{if $status==0}
<h2>Přihlášení</h2>
<table style="border-collapse: separate; border : 0px none; background-color : transparent;">
  <tbody>
    <tr>
      <td>Email</td>
      <td><input class="text" type="text" size="40" name="logEmail" value="{$logEmail}"/></td>
    </tr>
    <tr>
      <td>Heslo</td>
      <td><input class="text" type="password" size="40" name="logPass"/></td>
    </tr>
    <tr>
      <td colspan=2>
        <input type="submit" name="loginBT" value="Přihlásit se" class="button" >
        <input type="submit" name="newPassBT" value="Registrovat se, zapomenuté heslo" class="button" >
      </td>
    </tr>
  </tbody>
</table>
{*registrace fáze 1*}
{elseif $status==10}
<h2>Registrace, zapomenuté heslo</h2>
<table style="border-collapse: separate; border : 0px none; background-color : transparent;">
  <tbody>
    <tr>
      <td>Email</td>
      <td><input class="text" type="text" size="40" name="logEmail" value="{$logEmail}"/></td>
    </tr>
    <tr>
      <td colspan=2>
        <input type="submit" name="regContBT" value="Pokračovat" class="button" >
      </td>
    </tr>
  </tbody>
</table>
{*registrace fáze 2*}
{elseif $status==11}
<h2>Registrace 1/2</h2>
<table style="border-collapse: separate; border : 0px none; background-color : transparent;">
  <tbody>
    <tr>
      <td><input type="radio" name="roleRAD" value="referent"></td>
      <td>Referent (vyučující)</td>
    </tr>
    <tr>
      <td><input type="radio" name="roleRAD" value="student"></td>
      <td>Student</td>
    </tr>
    <tr>
      <td colspan=2>
        <input type="submit" name="regCont2BT" value="Pokračovat" class="button" >
      </td>
    </tr>

  </tbody>
</table>
{*registrace fáze 3ref*}
{elseif $status==121}
<h2>Registrace 2/2</h2>
<table style="border-collapse: separate; border : 0px none; background-color : transparent;">
  <tbody>
    <tr><td style="text-align: right">* Škola:</td><td><select name="refSchool" tabindex=1>
     <option value="NULL">---- vyberte školu ----</option>
 {foreach $schools as $school}
     <option value={$school->school_id} {if $school->selected}selected="selected"{/if}>{$school->school_choice}</option>
 {/foreach}
     </select>
     <input tabindex="13" type="submit" name="missSchoolBT" value="Škola není na seznamu" class="button" />
     </td>
   </tr>
   <tr>
     <td style="text-align: right">* Jméno referenta FO:</td>
     <td><input class="text" tabindex="2" type="text" size="40" value="{$refName}" name="refName" /></td>
   </tr>
   <tr>
     <td style="text-align: right">* Vaš email:</td>
     <td><input class="text" tabindex="3" type="text" size="40" value="{$refMail}" name="refMail" /></td>
   </tr>
   <tr>
     <td style="text-align: right">Váš telefon:</td>
     <td><input class="text" tabindex="4" type="text" size="40" value="{$refPhone}" name="refPhone" /></td>
   </tr>
   <tr>
     <td style="text-align: right">Heslo:</td>
     <td><input class="text" tabindex="6" type="password" size="40" value="" name="newPass" /></td>
   </tr>
   <tr>
     <td style="text-align: right">Heslo znovu:</td>
     <td><input class="text" tabindex="7" type="password" size="40" value="" name="newPass2" /></td>
   </tr>
   <tr>
      <td colspan=2>
        <input type="submit" name="regCont31BT" value="Pokračovat" class="button" >
      </td>
    </tr>
  </tbody>
</table>

{*registrace fáze 3stud*}
{elseif $status==122}

TODO

{*registrace školy*}
{elseif $status==131 || $status==132}
<h2>Registrace školy</h2>
<table style="border-collapse: separate; border : 0px none; background-color : transparent;">
  <tbody>
  <tr>
    <td style="text-align: right">Zkratka názvu školy:</td>
    <td><input class="text" type="text" size="40" value="{$schName}" name="schName" /></td>
  </tr>
  <tr>
    <td style="text-align: right">Úplný název školy dle MŠMT:</td>
    <td><input class="text" type="text" size="40" value="{$schFullName}" name="schFullName" /></td>
  </tr>
  <tr>
    <td style="text-align: right">Adresa školy:</td>
    <td><input class="text" type="text" size="40" value="{$schAdr}" name="schAdr" /></td>
  </tr>
  <tr>
    <td style="text-align: right">Kontakní email na ředitelství:</td>
    <td><input class="text" type="text" size="40" value="{$schEmail}" name="schEmail" /></td>
  </tr>
  <tr>
        <td><input type="submit" name="schSaveBT" value="Uložit školu" class="button" /></td>
        <td><input type="submit" name="schCancBT" value="Zpět" class="button" /></td>
  </tr>
  </tbody>
</table>

{*dashboard*}
{elseif $status==20}
    TODO Dashboard.
{else}
<p>Nastala chyba {$status}.</p>
{/if}

</form>


{control overview}
