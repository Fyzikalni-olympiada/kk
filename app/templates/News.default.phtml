@{block #content}
<h1>{$heading}</h1>

<div id="editable">
    {!$document->html}
</div>

<div class="news">
{foreach $list as $item}
    <h2>{$item->heading}</h2>
    {!$item->html}
    <p class="createdate">
         {$item->createdAt->format('j. n. Y H:i')} napsal <span class="small">{$item->changes[0]->identity}</span>
    </p>
    <span class="article_separator">&nbsp;</span>
{/foreach}

