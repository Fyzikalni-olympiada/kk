@{block #content}
<h1>{$heading}</h1>
<div id="editable">
    {!$document->html}
</div>

<ul>
{foreach $list as $item}
    {if $item instanceof Eywa\CMS\Model\Page}
    <li><a href="{dlink $item->path}" title="{$item->title}">{$item->name}</a></li>
    {elseif $item instanceof Eywa\CMS\Model\Redirect}
    <li>{if $item->location}<a href="{$item->location}" target="_blank">{/if}{$item->name}{if $item->location}</a>{/if}</li>
    {/if}
{/foreach}
</ul>

{control overview}
