<h2>Deduplikace</h2>
Příliš netestováno, pouze na vlastní nebezpečí.
<form name="selTable" method="POST" action="">
<select name="tab_select">
    <option value="">---- vyberte tabulku----</option>
    <option value=referents {if $tab_select=="referents"} selected="selected"{/if}>Referenti</option>
    <option value=persons   {if $tab_select=="persons"}   selected="selected"{/if}>Studenti</option>
{*    <option value=school       {if $tab_select=="school"}       selected="selected"{/if}>Školy</option>*}
    </select>
<select name="ord_select">
    <option value="">---- vyberte uspořádání----</option>
    <option value="referent_name"  {if $ord_select=="referent_name"}  selected="selected"{/if}>(ref)referent_name</option>
    <option value="referent_phone" {if $ord_select=="referent_phone"} selected="selected"{/if}>(ref)referent_phone</option>
    <option value="referent_email" {if $ord_select=="referent_email"} selected="selected"{/if}>(ref)referent_email</option>
    <option value="school_id"      {if $ord_select=="school_id"}      selected="selected"{/if}>(ref)school_id</option>
    <option value="name"           {if $ord_select=="name"}           selected="selected"{/if}>(std)name</option>
    <option value="surname"        {if $ord_select=="surname"}        selected="selected"{/if}>(std)surname</option>
    <option value="email"          {if $ord_select=="email"}          selected="selected"{/if}>(std)email</option>
    <option value="born_date"      {if $ord_select=="born_date"}      selected="selected"{/if}>(std)born_date</option>
    </select>
WHERE<input type="text"   value="{$whereclause}" name="whereclause"><br />
<input type="submit" value="Vybrat" class="button" />
<input type="submit" value="Mergovat do menšího" class="button" name="mergeTL"/>
<input type="submit" value="Mergovat do většího" class="button" name="mergeTH"/>
<input type="submit" value="Deduplikovat"        class="button" name="deduplBT"/>
<input type="submit" value="Auto deduplikovat test"        class="button" name="adeduplBTtest"/>
<input type="submit" value="Auto deduplikovat i null test" class="button" name="adeduplBTnulltest"/>
<strong>!!!DANGER ZONE!!!
<input type="submit" value="Auto deduplikovat"        class="button" name="adeduplBT"/>
<input type="submit" value="Auto deduplikovat i null" class="button" name="adeduplBTnull"/>
!!!DANGER ZONE!!!</strong>


<style>
p.error{
    margin: 10px;
}
</style>
<div style="background-color:#ffaaaa"><p class="error">{!$errorMsg}</p></div>
<div style="background-color:#aaffaa"><p class="error">{!$okMsg}</p></div>

<br />

{if $data!=NULL}
<table>
<thead>
  <th></th>
  {foreach $keys as $key}
    <th>{$key}</th>
  {/foreach}
</thead>
<tbody>
{foreach $data as $row}
  <tr>
    <td>
        <input type="checkbox" name="ADV{$row->$keys[0]}" value="1"/>
   </td>
  {foreach $keys as $key}
    <td>{$row->$key}</td>
  {/foreach}
  </tr>
{/foreach}
</table>
</form>
{/if}


