    <td>{if $row->U3>=5}<strong>{/if}{$row->U3}</strong></td>
    <td>{if $row->U4>=5}<strong>{/if}{$row->U4}</strong></td>
    <td>{if $row->U5>=5}<strong>{/if}{$row->U5}</strong></td>
    <td>{if $row->U6>=5}<strong>{/if}{$row->U6}</strong></td>
    <td>{if $row->U7>=5}<strong>{/if}{$row->U7}</strong></td>
    <td>{$row->sum}</td>
