{?$index++}
{/foreach}
  <tr>
    <td colspan=10>
      <input type="submit" value="Uložit" class="button" name="saveBT"/>
    </td>
  </tr>
</table>
<input type="hidden" value="{$index}" name="STOT">

</form>
{/if}

